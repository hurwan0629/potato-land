# 프론트에서 호출할 API 베이스 경로 (기본: 상대경로 /api, vite proxy가 백엔드로 전달)
VITE_API_BASE_URL=

# vite dev 서버 프록시가 실제로 연결할 백엔드 주소
VITE_API_TARGET=

# [개발 편의용] 상시 로그인 (mock, API 호출 없음)
# 백엔드에 요청을 아예 보내지 않고, 앱이 뜨자마자 아래 정보로 로그인된 상태로 시작함
# (DEV 빌드에서만 동작, 프로덕션 빌드에는 절대 반영 안 됨)
VITE_DEV_MOCK_LOGIN=
VITE_DEV_MOCK_USER_ID=
VITE_DEV_MOCK_NICKNAME=
VITE_DEV_MOCK_ROLE=