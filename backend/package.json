{
  "name": "potato-land-server",
  "version": "1.0.0",
  "description": "potato-land: used shop and auction service",
  "keywords": [
    "auction",
    "used",
    "shop",
    "admin",
    "jwt",
    "multer",
    "socket",
    "rest",
    "cooperation",
    "redis",
    "postgresql",
    "docker",
    "express",
    "react"
  ],
  "license": "ISC",
  "author": "hurwan",
  "type": "module",
  "main": "./src/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon ./src/server.js",
    "start": "cross-env NODE_ENV=production node ./src/server.js",
    "test": "cross-env NODE_ENV=test node --test",
    "db:migrate": "node ./database/migrate.js",
    "db:seed": "node ./database/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "redis": "^6.2.0",
    "socket.io": "^4.8.3",
    "solapi": "^6.0.1"
  }
}
