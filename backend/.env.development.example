# 개발시에 적극적으로 사용하게 될 환경변수 설정 파일

##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  

# server
HOST=127.0.0.1
PORT=8080

# client
CLIENT_ORIGIN=http://127.0.0.1:5173

##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  

# db
DATABASE_URL=postgresql://postgres...

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

DATABASE_NAME=potato_land
DATABASE_USER=potato
DATABASE_PASSWORD=1234

##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  

# redis
REDIS_URL=rediss://default...

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=1234

##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  

# cookie
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  

# jwt
## 15분
ACCESS_TOKEN_EXPIRES_IN_SEC=900
ACCESS_TOKEN_COOKIE_PATH=/
ACCESS_TOKEN_SECRET=64-byte-secret-64-byte-secret-64-byte-secret

## 7일
REFRESH_TOKEN_EXPIRES_IN_SEC=604800
REFRESH_TOKEN_COOKIE_PATH=/api/auth/refresh
REFRESH_TOKEN_SECRET=64-byte-secret-64-byte-secret-64-byte-secret

##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  

# SMS
SMS_API_KEY=
SMS_API_SECRET=
# SOLAPI에 등록되어 ACTIVE 상태인 발신번호를 숫자만 입력
SMS_PHONE_FROM=
SMS_OWNER_NAME=
PHONE_AUTH_CODE_TTL_SEC=180
PHONE_AUTH_COOLDOWN_SEC=30
PHONE_AUTH_VERIFIED_TTL_SEC=600
PHONE_AUTH_MAX_ATTEMPTS=5

##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  

# bcrypt
BCRYPT_SALT_ROUNDS=10

##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  

# recovery scheduler
AUCTION_RECOVERY_CRON=*/5 * * * *

##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  

# upload (multer)
UPLOAD_BASE_DIR=uploads
UPLOAD_LISTING_IMG_DIR=listings
UPLOAD_PROFILE_IMG_DIR=profiles
UPLOAD_CHAT_IMG_DIR=chats
# 5MiB
UPLOAD_MAX_SIZE_BYTES=5242880

##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##

# development demo bot
DEMO_BOT_ENABLED=false
DEMO_BOT_INTERVAL_MS=5000
